# Admin seed — created on first request via ensureAdmin() if admins table is empty.
# Set the same vars in Vercel > Settings > Environment Variables (Production).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-before-running-seed

# Hosted persistence (Neon Postgres). When set, the app uses Postgres;
# without it, it falls back to local SQLite at ./data/techsoc.db.
# Get one free at https://neon.tech — pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/techsoc?sslmode=require

# Vercel Blob (uploads). Vercel > Storage > Blob > Create, then
# .env.local / Environment Variables. Without it, uploads stay on local disk.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
